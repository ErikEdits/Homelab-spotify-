<?xml version="1.0" encoding="utf-8"?>
<!-- Homify läuft im Heimnetz meist über http://192.168.x.x – das muss erlaubt sein.
     Über Tailscale (https://…ts.net) wird automatisch verschlüsselt. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
