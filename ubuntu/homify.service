# Vorlage – wird von ubuntu/install.sh --service nach /etc/systemd/system/ kopiert
[Unit]
Description=Homify - eigenes Spotify fuers Homelab
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUTF8=1
ExecStart=@ROOT@/.venv/bin/python -m homify run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
